@model IEnumerable<FullVoucherSystem.Models.ImprestHolder>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    bool isSearched = ViewBag.IsSearched ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Search Imprest Holder - UBTH</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f7f6;
            color: #333;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 30px;
            background-color: #ffffff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border-bottom: 3px solid #2e7d32;
        }

        .logo-area {
            display: flex;
            align-items: center;
        }

            .logo-area img {
                width: 55px;
                height: auto;
            }

            .logo-area h2 {
                margin: 0 0 0 15px;
                color: #2e7d32;
                font-size: 22px;
                font-weight: 700;
            }

        .user-info {
            color: #2e7d32;
            font-weight: 600;
            font-size: 15px;
            background-color: #e8f5e9;
            padding: 8px 16px;
            border-radius: 20px;
        }

        .container {
            max-width: 1050px;
            margin: 30px auto;
            padding: 0 15px;
        }

        .search-box {
            background: #ffffff;
            padding: 30px 35px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            border: 1px solid #e0e0e0;
            margin-bottom: 30px;
        }

        .page-title {
            text-align: center;
            color: #2e7d32;
            margin-top: 0;
            margin-bottom: 25px;
            font-size: 24px;
            letter-spacing: 0.5px;
            position: relative;
            padding-bottom: 10px;
        }

            .page-title::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 60px;
                height: 3px;
                background-color: #2e7d32;
                border-radius: 2px;
            }

        .search-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .field-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-weight: 600;
            font-size: 13px;
            color: #424242;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        input {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid #bdc3c7;
            border-radius: 6px;
            font-size: 14px;
            background-color: #ffffff;
            color: #333;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            input:focus {
                outline: none;
                border-color: #2e7d32;
                box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.15);
            }

        .actions-bar {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 20px;
        }

        .btn-search {
            padding: 11px 25px;
            background-color: #2e7d32;
            border: none;
            color: white;
            font-size: 15px;
            font-weight: 700;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            .btn-search:hover {
                background-color: #1b5e20;
            }

        .btn-reset {
            padding: 11px 20px;
            background-color: #616161;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            display: inline-block;
            transition: background-color 0.2s ease;
        }

            .btn-reset:hover {
                background-color: #424242;
            }

        .btn-close {
            padding: 11px 20px;
            background-color: #d32f2f;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            display: inline-block;
            transition: background-color 0.2s ease;
        }

            .btn-close:hover {
                background-color: #b71c1c;
            }

        .results-box {
            background: #ffffff;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            border: 1px solid #e0e0e0;
        }

        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

            .results-header h3 {
                margin: 0;
                color: #2e7d32;
            }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        th, td {
            padding: 12px 14px;
            text-align: left;
            border-bottom: 1px solid #e0e0e0;
        }

        th {
            background-color: #e8f5e9;
            color: #1b5e20;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 12px;
        }

        tr:hover {
            background-color: #f9f9f9;
        }

        .btn-view {
            padding: 6px 16px;
            background-color: #0275d8;
            color: white;
            text-decoration: none;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 600;
            display: inline-block;
            transition: background-color 0.2s ease;
        }

            .btn-view:hover {
                background-color: #025aa5;
            }

        .no-records {
            text-align: center;
            padding: 25px;
            color: #777;
            font-style: italic;
        }

        @@media (max-width: 600px) {
            .search-grid {
                grid-template-columns: 1fr;
            }

            .actions-bar {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo-area">
            <img src="~/images/ubth-logo.jpeg" alt="UBTH Logo" />
            <h2>UBTH Voucher System</h2>
        </div>

        <div class="user-info">
            @ViewBag.Surname @ViewBag.FirstName
        </div>
    </div>

    <div class="container">

        <!-- Search Criteria Form -->
        <div class="search-box">
            <h2 class="page-title">Search Imprest Holder</h2>

            <form asp-controller="ImprestHolder" asp-action="Search" method="get">
                <div class="search-grid">

                    <div class="field-group">
                        <label for="searchName">Search by Imprest Holder Names</label>
                        <input type="text" id="searchName" name="searchName"
                               value="@ViewBag.SearchName"
                               placeholder="Search by Imprest Holder Names"
                               list="namesList" autocomplete="off" />
                        <datalist id="namesList"></datalist>
                    </div>

                    <div class="field-group">
                        <label for="searchStaffId">Search by Staff ID</label>
                        <input type="text" id="searchStaffId" name="searchStaffId"
                               value="@ViewBag.SearchStaffId"
                               placeholder="Search by Staff ID"
                               list="staffIdsList" autocomplete="off" />
                        <datalist id="staffIdsList"></datalist>
                    </div>

                </div>

                <div class="actions-bar">
                    <button type="submit" class="btn-search">Search</button>
                    <a href="/ImprestHolder/Search" class="btn-reset">Clear Search</a>
                    <a href="/Dashboard/Index" class="btn-close">Close</a>
                </div>
            </form>
        </div>

        <!-- Search Results Grid -->
        @if (isSearched)
        {
            <div class="results-box">
                <div class="results-header">
                    <h3>Search Results (@Model.Count() record(s) found)</h3>
                    <a href="/Dashboard/Index" class="btn-close">Close</a>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Folio Number</th>
                                    <th>Staff ID</th>
                                    <th>Staff Name</th>
                                    <th>Designation</th>
                                    <th>Department</th>
                                    <th>Phone Number</th>
                                    <th style="text-align: center;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><strong>@item.FolioNumber</strong></td>
                                        <td>@item.StaffId</td>
                                        <td>@item.StaffNames</td>
                                        <td>@item.Designation</td>
                                        <td>@item.Department</td>
                                        <td>@item.PhoneNumber</td>
                                        <td style="text-align: center;">
                                            <a href="/ImprestHolder/Details/@item.FolioNumber" class="btn-view">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="no-records">
                        No matching imprest holder record found for the specified search criteria.
                    </div>
                }
            </div>
        }

    </div>

    <!-- Script for Live Search Datalist Autocomplete -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const nameInput = document.getElementById("searchName");
            const staffIdInput = document.getElementById("searchStaffId");

            nameInput.addEventListener("focus", function () {
                fetch('/ImprestHolder/GetHolderNames')
                    .then(response => response.json())
                    .then(data => {
                        const datalist = document.getElementById("namesList");
                        datalist.innerHTML = "";
                        data.forEach(item => {
                            const option = document.createElement("option");
                            option.value = item;
                            datalist.appendChild(option);
                        });
                    });
            });

            staffIdInput.addEventListener("focus", function () {
                fetch('/ImprestHolder/GetStaffIds')
                    .then(response => response.json())
                    .then(data => {
                        const datalist = document.getElementById("staffIdsList");
                        datalist.innerHTML = "";
                        data.forEach(item => {
                            const option = document.createElement("option");
                            option.value = item;
                            datalist.appendChild(option);
                        });
                    });
            });
        });
    </script>

</body>
</html>