<!DOCTYPE html>
<html>
<head>
    <title>Computerized Payment Voucher System</title>
    <style>
        body {
            font-family: Arial;
            margin: 0;
            background-color: #f5f7f5;
        }

        .header {
            background-color: #006400;
            color: white;
            padding: 10px;
            display: flex;
            align-items: center;
        }

            .header img {
                height: 70px;
                margin-right: 15px;
            }

        .header-title {
            font-size: 22px;
            font-weight: bold;
        }

        .nav {
            background-color: #228B22;
            padding: 10px;
        }

            .nav a {
                color: white;
                margin-right: 15px;
                text-decoration: none;
                font-weight: bold;
            }

        .container {
            padding: 20px;
        }

        button {
            background-color: #006400;
            color: white;
            padding: 6px 12px;
            border: none;
        }

        a.button {
            background-color: #006400;
            color: white;
            padding: 6px 12px;
            text-decoration: none;
        }

        table {
            border-collapse: collapse;
        }

        th {
            background-color: #006400;
            color: white;
        }

        /* ✅ FIXED ANIMATION */
        .fade-in {
            animation: fadeIn 1.5s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }
    </style>
</head>

<body>

    <!-- ✅ HEADER WITH LOGO -->
    <div class="header">
        <img src="~/images/ubth-logo.jpeg" />
        <div class="header-title">
            UNIVERSITY OF BENIN TEACHING HOSPITAL<br />
            Computerized Payment Voucher System
        </div>
    </div>

    <!-- ✅ NAVIGATION -->
    <div class="nav">
        <a href="/Dashboard/Index">Dashboard</a>
        <a href="/Voucher/Create">Voucher Entry</a>
        <a href="/BillingCertification/Index">Certification</a>
    </div>

    <!-- ✅ MAIN CONTENT -->
    <div class="container fade-in">
        @RenderBody()
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>