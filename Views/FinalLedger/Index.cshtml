@{
    Layout = null;
    ViewData["Title"] = "Final Ledger";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Final Ledger - UBTH Voucher Portal</title>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>

        .btn-analysis {
            background-color: #8a5a00;
        }

        .analysis-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin: 15px 0;
            padding: 12px;
            background: #f0f7f2;
            border: 1px solid #d5e6da;
            border-radius: 6px;
        }

            .analysis-summary strong {
                color: #0b7a43;
            }

        .analysis-table {
            width: 100%;
            min-width: 650px;
            border-collapse: collapse;
            font-size: 13px;
        }

            .analysis-table th {
                background-color: #0b7a43;
                color: white;
                padding: 10px;
                text-align: left;
                position: static;
            }

            .analysis-table td {
                padding: 9px;
                border: 1px solid #ddd;
            }

            .analysis-table .amount {
                text-align: right;
                font-variant-numeric: tabular-nums;
            }

            .analysis-table .grand-total td {
                background: #e3f1e7;
                font-weight: bold;
                border-top: 2px solid #0b7a43;
            }

        .analysis-empty {
            text-align: center;
            padding: 20px;
            color: #666;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f8f4;
            color: #1e3d2f;
        }

        .header {
            background-color: white;
            border-bottom: 5px solid #0b7a43;
            padding: 15px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .portal-title h1 {
            margin: 0;
            font-size: 24px;
            color: #0b7a43;
        }

        .container {
            width: 98%;
            margin: 20px auto;
        }

        .ledger-columns {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .column {
            flex: 1;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            border-top: 4px solid #0b7a43;
        }

        .column-title {
            color: #0b7a43;
            border-bottom: 2px solid #e2ece6;
            padding-bottom: 8px;
            margin-top: 0;
        }

        .filter-group {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 15px;
            background: #f9fbf9;
            padding: 15px;
            border-radius: 6px;
            border: 1px solid #e2ece6;
            align-items: flex-end;
        }

        .filter-row {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .filter-row label {
                font-weight: bold;
                font-size: 13px;
            }

            .filter-row select,
            .filter-row input {
                padding: 7px 10px;
                border: 1px solid #ccc;
                border-radius: 4px;
                min-width: 150px;
                box-sizing: border-box;
            }

        .btn-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 8px 14px;
            border: none;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
            color: white;
            font-size: 13px;
        }

        .btn-search {
            background-color: #0b7a43;
        }

        .btn-excel {
            background-color: #1d6f42;
        }

        .btn-pdf {
            background-color: #b82c2c;
        }

        .btn-chart {
            background-color: #2b5b84;
        }

        .btn-reset {
            background-color: #59636e;
        }

        .btn:hover {
            opacity: 0.9;
        }

        .table-responsive {
            overflow: auto;
            max-height: 500px;
            margin-top: 15px;
            border: 1px solid #ddd;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            min-width: 1200px;
        }

        th {
            background-color: #0b7a43;
            color: white;
            padding: 8px;
            text-align: left;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        td {
            padding: 8px;
            border-bottom: 1px solid #ddd;
            white-space: nowrap;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .status-message {
            display: none;
            margin-top: 10px;
            padding: 10px;
            border-radius: 4px;
            background: #e8f5ec;
            color: #14532d;
        }

            .status-message.error {
                background: #fdecec;
                color: #8b1e1e;
            }

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background: rgba(0,0,0,0.5);
        }

        .modal-content {
            background: white;
            margin: 5% auto;
            padding: 20px;
            width: 60%;
            max-width: 900px;
            border-radius: 8px;
            position: relative;
        }

        .close-btn {
            position: absolute;
            right: 15px;
            top: 10px;
            font-size: 24px;
            cursor: pointer;
            font-weight: bold;
            color: #aaa;
        }

            .close-btn:hover {
                color: black;
            }

        @@media (max-width: 768px) {
            .header {
                padding: 15px;
                align-items: flex-start;
                flex-direction: column;
            }

            .portal-title h1 {
                font-size: 20px;
            }

            .column {
                padding: 12px;
            }

            .filter-row,
            .filter-row select,
            .filter-row input {
                width: 100%;
            }

            .filter-group {
                align-items: stretch;
            }

            .modal-content {
                width: 90%;
                box-sizing: border-box;
            }
        }
    </style>
</head>

<body>
    <div class="header">
        <div class="portal-title">
            <h1>University of Benin Teaching Hospital - Final Ledger</h1>
        </div>

        <div>
            <a href="@Url.Action("Index", "Dashboard")"
               style="background:#0b7a43;color:white;padding:8px 15px;border-radius:4px;text-decoration:none;font-weight:bold;">
                Back to Dashboard
            </a>
        </div>
    </div>

    <div class="container">
        <div class="ledger-columns">

            <!-- RAISED VOUCHERS: FILTERS UNCHANGED -->
            <div class="column">
                <h2 class="column-title">Raised Vouchers</h2>

                <div class="filter-group">
                    <div class="filter-row">
                        <label for="raisedType">Voucher Type:</label>
                        <select id="raisedType">
                            <option value="S">S</option>
                            <option value="SA">SA</option>
                            <option value="SA-2">SA-2</option>
                            <option value="E">E</option>
                            <option value="EE">EE</option>
                            <option value="ES">ES</option>
                            <option value="EL">EL</option>
                            <option value="EP">EP</option>
                            <option value="ER">ER</option>
                            <option value="ICH">ICH</option>
                            <option value="C">C</option>
                            <option value="ALL Es">ALL Es</option>
                            <option value="ALL TYPES" selected>ALL TYPES</option>
                        </select>
                    </div>

                    <div class="filter-row">
                        <label for="raisedStartDate">Start Date:</label>
                        <input type="date" id="raisedStartDate" />
                    </div>

                    <div class="filter-row">
                        <label for="raisedEndDate">End Date:</label>
                        <input type="date" id="raisedEndDate" />
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-search"
                                onclick="searchRaised()">
                            Search
                        </button>

                        <button type="button" class="btn btn-excel"
                                onclick="exportExcel('raisedTable', 'Raised_Vouchers')">
                            Export to Excel
                        </button>

                        <button type="button" class="btn btn-pdf"
                                onclick="exportPDF('raisedPrintArea', 'Raised_Vouchers')">
                            Export to PDF
                        </button>

                        <button type="button" class="btn btn-analysis"
                                onclick="openAnalysedReport('raised')">
                            Analysed Report
                        </button>
                        
                        <button type="button" class="btn btn-chart"
                                onclick="openChartModal('raised')">
                            View Chart
                        </button>
                    </div>
                </div>

                <div id="raisedStatus" class="status-message"></div>

                <div class="table-responsive" id="raisedPrintArea">
                    <table id="raisedTable">
                        <thead>
                            <tr>
                                <th>Voucher No</th>
                                <th>Date Raised</th>
                                <th>Payee</th>
                                <th>Class Code</th>
                                <th>Gross Amount</th>
                                <th>Contract Amount</th>
                                <th>VAT</th>
                                <th>FGN_WHT</th>
                                <th>EDG_WHT</th>
                                <th>Stamp Duty</th>
                                <th>Net Amount</th>
                                <th>Paid Date</th>
                                <th>Batch No</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="14" style="text-align:center;">
                                    No search performed yet.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PAID VOUCHERS: NEW FUNDING ACCOUNT AND BATCH FILTERS -->
            <div class="column">
                <h2 class="column-title">Paid Vouchers</h2>

                <div class="filter-group">
                    <div class="filter-row">
                        <label for="paidType">Voucher Type:</label>
                        <select id="paidType">
                            <option value="S">S</option>
                            <option value="SA">SA</option>
                            <option value="SA-2">SA-2</option>
                            <option value="E">E</option>
                            <option value="EE">EE</option>
                            <option value="ES">ES</option>
                            <option value="EL">EL</option>
                            <option value="EP">EP</option>
                            <option value="ER">ER</option>
                            <option value="ICH">ICH</option>
                            <option value="C">C</option>
                            <option value="ALL Es">ALL Es</option>
                            <option value="ALL TYPES" selected>ALL TYPES</option>
                        </select>
                    </div>

                    <div class="filter-row">
                        <label for="paidFundingAccount">Funding Account:</label>
                        <select id="paidFundingAccount">
                            <option value="ALL" selected>ALL ACCOUNTS</option>
                            <option value="DRF">DRF</option>
                            <option value="DFR">DFR</option>
                            <option value="MISCELLANEOUS">MISCELLANEOUS</option>
                            <option value="NHIA">NHIA</option>
                            <option value="SCHOOLS">SCHOOLS</option>
                        </select>
                    </div>

                    <div class="filter-row">
                        <label for="paidBatchNo">Batch No:</label>
                        <input type="text" id="paidBatchNo"
                               placeholder="Enter batch number" />
                    </div>

                    <div class="filter-row">
                        <label for="paidStartDate">Start Date:</label>
                        <input type="date" id="paidStartDate" />
                    </div>

                    <div class="filter-row">
                        <label for="paidEndDate">End Date:</label>
                        <input type="date" id="paidEndDate" />
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-search"
                                onclick="searchPaid()">
                            Search
                        </button>

                        <button type="button" class="btn btn-reset"
                                onclick="resetPaidFilters()">
                            Reset Filters
                        </button>

                        <button type="button" class="btn btn-excel"
                                onclick="exportExcel('paidTable', 'Paid_Vouchers')">
                            Export to Excel
                        </button>

                        <button type="button" class="btn btn-pdf"
                                onclick="exportPDF('paidPrintArea', 'Paid_Vouchers')">
                            Export to PDF
                        </button>

                        

                        <button type="button" class="btn btn-analysis"
                                onclick="openAnalysedReport('paid')">
                            Analysed Report
                        </button>
                        
                        <button type="button" class="btn btn-chart"
                                onclick="openChartModal('paid')">
                            View Chart
                        </button>
                    </div>
                </div>

                <div id="paidStatus" class="status-message"></div>

                <div class="table-responsive" id="paidPrintArea">
                    <table id="paidTable">
                        <thead>
                            <tr>
                                <th>Voucher No</th>
                                <th>Date Raised</th>
                                <th>Payee</th>
                                <th>Class Code</th>
                                <th>Gross Amount</th>
                                <th>Contract Amount</th>
                                <th>VAT</th>
                                <th>FGN_WHT</th>
                                <th>EDG_WHT</th>
                                <th>Stamp Duty</th>
                                <th>Net Amount</th>
                                <th>Paid Date</th>
                                <th>Funding Account</th>
                                <th>Batch No</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="13" style="text-align:center;">
                                    No search performed yet.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <!-- CHART MODAL -->
    <div id="chartModal" class="modal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeChartModal()">&times;</span>

            <h3 id="chartModalTitle">
                Classification Code Frequency Analysis
            </h3>

            <div style="margin-bottom:15px;">
                <label for="chartTypeSelect">Select Chart Type:</label>
                <select id="chartTypeSelect" onchange="changeChartType()">
                    <option value="bar">Bar Chart</option>
                    <option value="pie">Pie Chart</option>
                    <option value="line">Line Chart</option>
                    <option value="doughnut">Doughnut Chart</option>
                    <option value="polarArea">Polar Area</option>
                </select>
            </div>

            <div style="height:350px;">
                <canvas id="ledgerChart"></canvas>
            </div>
        </div>
    </div>


    <!-- ANALYSED REPORT MODAL -->
    <div id="analysisModal" class="modal">
        <div class="modal-content" style="width:90%;max-width:1100px;">
            <span class="close-btn"
                  onclick="closeAnalysedReport()">&times;</span>

            <h3 id="analysisModalTitle"
                style="color:#0b7a43;margin-top:0;">
                Classification Code Analysed Report
            </h3>

            <div id="analysisCriteria"
                 style="margin-bottom:12px;color:#555;">
            </div>

            <div class="analysis-summary">
                <div>
                    <strong>Vouchers:</strong>
                    <span id="analysisVoucherCount">0</span>
                </div>

                <div>
                    <strong>Classification Codes:</strong>
                    <span id="analysisCodeCount">0</span>
                </div>

                <div>
                    <strong>Grand Total (₦):</strong>
                    <span id="analysisGrandTotal">0.00</span>
                </div>
            </div>

            <div class="table-responsive" id="analysisPrintArea">
                <table class="analysis-table" id="analysisTable">
                    <thead>
                        <tr>
                            <th>S/N</th>
                            <th>Classification Code</th>
                            <th>Classification Name</th>
                            <th>Voucher Count</th>
                            <th style="text-align:right;">
                                Total Amount (₦)
                            </th>
                        </tr>
                    </thead>

                    <tbody id="analysisTableBody">
                        <tr>
                            <td colspan="5" class="analysis-empty">
                                No report generated.
                            </td>
                        </tr>
                    </tbody>

                    <tfoot>
                        <tr class="grand-total">
                            <td colspan="3">GRAND TOTAL</td>
                            <td id="analysisTotalCount">0</td>
                            <td id="analysisFooterTotal"
                                class="amount">
                                ₦0.00
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="btn-group" style="margin-top:15px;">
                <button type="button" class="btn btn-excel"
                        onclick="exportExcel('analysisTable','Classification_Analysed_Report')">
                    Export Report to Excel
                </button>

                <button type="button" class="btn btn-pdf"
                        onclick="exportPDF('analysisPrintArea','Classification_Analysed_Report')">
                    Export Report to PDF
                </button>

                <button type="button" class="btn btn-reset"
                        onclick="closeAnalysedReport()">
                    Close Report
                </button>
            </div>
        </div>
    </div>

    <script>
        let raisedDataCache = [];
        let paidDataCache = [];
        let activeChart = null;
        let currentChartData = [];

        function getVal(item, keys, defaultVal = 0) {
            for (const key of keys) {
                if (item[key] !== undefined && item[key] !== null) {
                    return item[key];
                }
            }

            return defaultVal;
        }

        function escapeHtml(value) {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function toNumber(value) {
            const number = Number(value);
            return Number.isFinite(number) ? number : 0;
        }

        function formatAmount(value) {
            return toNumber(value).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function formatDate(value) {
            if (!value) return "";

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) return "";

            return date.toLocaleDateString();
        }



