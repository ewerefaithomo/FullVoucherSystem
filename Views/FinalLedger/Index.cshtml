            "22021009": "SPORTING ACTIVITIES",
            "22021011": "RECRUITMENT AND APPOINTMENT (SERVICE WIDE)",
            "22021013": "PROMOTION (SERVICE WIDE)",
            "22021014": "ANNUAL BUDGET EXPENSES & ADMINISTRATION",
            "22021041": "CONTIGENCY",
            "23050101": "RESEARCH AND DEVELOPMENT",
            "31040102": "INTER-ACCOUNT TRANSFER",
            "31040104": "REVENUE REMITTANCE",
            "31060101": "IMPREST",
            "31060301": "SPECIAL IMPREST (SERVICE WIDE)",
            "00000000": "UNPAID VOUCHERS"
        };


        // Normalise a code without converting it to a number.
        // This preserves trailing digits such as .10 and .11.
        function normaliseClassificationCode(value) {
            return String(value ?? "").trim();
        }


        // Return the correct amount field from a voucher.
        // TotalAmount represents the net amount in this application.
        function getVoucherNetAmount(item) {
            return toNumber(
                getVal(item, ["totalAmount", "TotalAmount"], 0)
            );
        }


        // Use the current search results to generate the report.

        async function openAnalysedReport(source) {
            const isRaised = source === "raised";
            let data;

            if (isRaised) {
                data = raisedDataCache;
            } else {
                const sDate =
                    document.getElementById("paidStartDate").value;
                const eDate =
                    document.getElementById("paidEndDate").value;

                if (sDate && eDate && sDate > eDate) {
                    alert("Start Date cannot be later than End Date.");
                    return;
                }

                const params = new URLSearchParams({
                    voucherType:
                        document.getElementById("paidType").value,
                    fundingAccount:
                        document.getElementById("paidFundingAccount").value,
                    batchNo:
                        document.getElementById("paidBatchNo").value.trim(),
                    startDate: sDate,
                    endDate: eDate
                });

                try {
                    const response = await fetch(
                        "/FinalLedger/SearchPaidVouchersForAnalysis",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded"
                            },
                            body: params.toString()
                        }
                    );

                    if (!response.ok) {
                        throw new Error(
                            "Unable to retrieve paid vouchers from Final_Ledger and Advances."
                        );
                    }

                    data = await response.json();
                } catch (error) {
                    alert(
                        error.message ||
                        "An error occurred while generating the analysed report."
                    );
                    return;
                }
            }

            if (!Array.isArray(data) || data.length === 0) {
                alert(
                    "No voucher records were found for the selected search criteria."
                );
                return;
            }

            const groups = new Map();
            let grandTotal = 0;

            data.forEach(item => {
                const rawCode = getVal(
                    item,
                    ["classificationCode", "ClassificationCode"],
                    ""
                );

                const code = normaliseClassificationCode(rawCode);
                const key = code || "UNCLASSIFIED";

                const amount = getVoucherNetAmount(item);

                if (!groups.has(key)) {
                    groups.set(key, {
                        code: code || "Unclassified",
                        name: classificationNames[code] ||
                            (code
                                ? "Classification name not supplied"
                                : "Unclassified"),
                        count: 0,
                        amount: 0
                    });
                }

                const group = groups.get(key);
                group.count += 1;
                group.amount += amount;
                grandTotal += amount;
            });

            const reportRows = Array.from(groups.values())
                .sort((a, b) => a.code.localeCompare(
                    b.code,
                    undefined,
                    { numeric: true, sensitivity: "base" }
                ));

            document.getElementById("analysisModalTitle").textContent =
                isRaised
                    ? "Raised Vouchers - Classification Code Analysed Report"
                    : "Paid Vouchers - Classification Code Analysed Report";

            document.getElementById("analysisCriteria").textContent =
                buildAnalysisCriteria(source);

            document.getElementById("analysisVoucherCount").textContent =
                data.length.toLocaleString();

            document.getElementById("analysisCodeCount").textContent =
                reportRows.length.toLocaleString();

            document.getElementById("analysisGrandTotal").textContent =
                "₦" + formatAmount(grandTotal);

            document.getElementById("analysisTotalCount").textContent =
                data.length.toLocaleString();

            document.getElementById("analysisFooterTotal").textContent =
                "₦" + formatAmount(grandTotal);

            const tbody = document.getElementById("analysisTableBody");

            tbody.innerHTML = reportRows.map((row, index) => `
                <tr>
                    <td>${index + 1}</td>
                    <td>${escapeHtml(row.code)}</td>
                    <td>${escapeHtml(row.name)}</td>
                    <td>${row.count.toLocaleString()}</td>
                    <td class="amount">₦${formatAmount(row.amount)}</td>
                </tr>
            `).join("");

            document.getElementById("analysisModal").style.display = "block";
        }


        // Show the search criteria used to produce the report.
        function buildAnalysisCriteria(source) {
            if (source === "raised") {
                const type = document.getElementById("raisedType").value;
                const startDate = document.getElementById("raisedStartDate").value;
                const endDate = document.getElementById("raisedEndDate").value;

                return [
                    "Voucher Type: " + type,
                    "Start Date: " + (startDate || "All dates"),
                    "End Date: " + (endDate || "All dates")
                ].join(" | ");
            }

            const type = document.getElementById("paidType").value;
            const account = document.getElementById("paidFundingAccount").value;
            const batch = document.getElementById("paidBatchNo").value.trim();
            const startDate = document.getElementById("paidStartDate").value;
            const endDate = document.getElementById("paidEndDate").value;

            return [
                "Voucher Type: " + type,
                "Funding Account: " + account,
                "Batch No: " + (batch || "All batches"),
                "Start Date: " + (startDate || "All dates"),
                "End Date: " + (endDate || "All dates")
            ].join(" | ");
        }


        function closeAnalysedReport() {
            document.getElementById("analysisModal").style.display = "none";
        }


        function showStatus(elementId, message, isError = false) {
            const element = document.getElementById(elementId);

            element.textContent = message;
            element.classList.toggle("error", isError);
            element.style.display = "block";
        }

        function clearStatus(elementId) {
            const element = document.getElementById(elementId);
            element.textContent = "";
            element.style.display = "none";
            element.classList.remove("error");
        }

        // Raised Vouchers: existing filters and search behaviour.
        async function searchRaised() {
            const vType = document.getElementById("raisedType").value;
            const sDate = document.getElementById("raisedStartDate").value;
            const eDate = document.getElementById("raisedEndDate").value;

            if (sDate && eDate && sDate > eDate) {
                showStatus(
                    "raisedStatus",
                    "Start Date cannot be later than End Date.",
                    true
                );
                return;
            }

            clearStatus("raisedStatus");

            const params = new URLSearchParams({
                voucherType: vType,
                startDate: sDate,
                endDate: eDate
            });

            try {
                const response = await fetch(
                    "/FinalLedger/SearchRaisedVouchers",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded"
                        },
                        body: params.toString()
                    }
                );

                if (!response.ok) {
                    throw new Error("The raised-voucher search failed.");
                }

                const data = await response.json();

                raisedDataCache = data;
                renderVoucherTable("raisedTable", data, false);
                showStatus(
                    "raisedStatus",
                    `${data.length} raised voucher(s) found.`
                );
            } catch (error) {
                showStatus(
                    "raisedStatus",
                    error.message || "Unable to search raised vouchers.",
                    true
                );
            }
        }

        // Paid Vouchers: searches by all supplied filters.
        async function searchPaid() {
            const vType = document.getElementById("paidType").value;
            const fundingAccount =
                document.getElementById("paidFundingAccount").value;
            const batchNo =
                document.getElementById("paidBatchNo").value.trim();
            const sDate = document.getElementById("paidStartDate").value;
            const eDate = document.getElementById("paidEndDate").value;

            if (sDate && eDate && sDate > eDate) {
                showStatus(
                    "paidStatus",
                    "Start Date cannot be later than End Date.",
                    true
                );
                return;
            }

            clearStatus("paidStatus");

            const params = new URLSearchParams({
                voucherType: vType,
                fundingAccount: fundingAccount,
                batchNo: batchNo,
                startDate: sDate,
                endDate: eDate
            });

            try {
                const response = await fetch(
                    "/FinalLedger/SearchPaidVouchers",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded"
                        },
                        body: params.toString()
                    }
                );

                if (!response.ok) {
                    throw new Error("The paid-voucher search failed.");
                }

                const data = await response.json();

                paidDataCache = data;
                renderVoucherTable("paidTable", data, true);
                showStatus(
                    "paidStatus",
                    `${data.length} paid voucher(s) found.`
                );
            } catch (error) {
                showStatus(
                    "paidStatus",
                    error.message || "Unable to search paid vouchers.",
                    true
                );
            }
        }

        // Renders either raised or paid voucher results.
                function renderVoucherTable(tableId, data, isPaid) {
            const tbody = document.querySelector(`#${tableId} tbody`);
            tbody.innerHTML = "";

            // Raised Vouchers: 13 columns.
            // Paid Vouchers: 14 columns, including Funding Account.
            const columnCount = isPaid ? 14 : 13;

            if (!Array.isArray(data) || data.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="${columnCount}" style="text-align:center;">
                            No matching records found.
                        </td>
                    </tr>`;

                return;
            }

            const rows = data.map(item => {
                const contractAmount = toNumber(
                    getVal(item, ["amount", "Amount"], 0)
                );

                const vat = toNumber(
                    getVal(item, ["vat", "VAT"], 0)
                );

                const fgn = toNumber(
                    getVal(
                        item,
                        ["fgN_WHT", "fgn_WHT", "FGN_WHT"],
                        0
                    )
                );

                const edg = toNumber(
                    getVal(
                        item,
                        ["edG_WHT", "edg_WHT", "EDG_WHT"],
                        0
                    )
                );

                const stamp = toNumber(
                    getVal(item, ["stampDuty", "StampDuty"], 0)
                );

                const netAmount = toNumber(
                    getVal(
                        item,
                        ["totalAmount", "TotalAmount"],
                        contractAmount
                    )
                );

                const grossAmount = contractAmount + vat;

                const voucherNumber = escapeHtml(
                    getVal(
                        item,
                        ["voucherNumber", "VoucherNumber"],
                        ""
                    )
                );

                const payee = escapeHtml(
                    getVal(item, ["payee", "Payee"], "")
                );

                const classificationCode = escapeHtml(
                    getVal(
                        item,
                        ["classificationCode", "ClassificationCode"],
                        ""
                    )
                );

                const dateRaised = formatDate(
                    getVal(item, ["date", "Date"], null)
                );

                let paidDate = "";
                let fundingAccount = "";
                let batchNo = "";

                if (isPaid) {
                    const rawProcessed = getVal(
                        item,
                        ["processedDate", "ProcessedDate"],
                        null
                    );

                    paidDate = rawProcessed
                        ? formatDate(rawProcessed)
                        : "";

                    // Retrieve Funding Account from the JSON record.
                    fundingAccount = escapeHtml(
                        getVal(
                            item,
                            ["fundingAccount", "FundingAccount"],
                            ""
                        )
                    );

                    batchNo = escapeHtml(
                        getVal(
                            item,
                            ["batch_No", "Batch_No", "batch_no"],
                            ""
                        )
                    );
                }

                // Keep the Raised Vouchers columns unchanged.
                if (!isPaid) {
                    return `
                        <tr>
                            <td>${voucherNumber}</td>
                            <td>${escapeHtml(dateRaised)}</td>
                            <td>${payee}</td>
                            <td>${classificationCode}</td>
                            <td>${formatAmount(grossAmount)}</td>
                            <td>${formatAmount(contractAmount)}</td>
                            <td>${formatAmount(vat)}</td>
                            <td>${formatAmount(fgn)}</td>
                            <td>${formatAmount(edg)}</td>
                            <td>${formatAmount(stamp)}</td>
                            <td>${formatAmount(netAmount)}</td>
                            <td>N/A</td>
                            <td>N/A</td>
                        </tr>`;
                }

                // Paid Vouchers includes Funding Account before Batch No.
                return `
                    <tr>
                        <td>${voucherNumber}</td>
                        <td>${escapeHtml(dateRaised)}</td>
                        <td>${payee}</td>
                        <td>${classificationCode}</td>
                        <td>${formatAmount(grossAmount)}</td>
                        <td>${formatAmount(contractAmount)}</td>
                        <td>${formatAmount(vat)}</td>
                        <td>${formatAmount(fgn)}</td>
                        <td>${formatAmount(edg)}</td>
                        <td>${formatAmount(stamp)}</td>
                        <td>${formatAmount(netAmount)}</td>
                        <td>${escapeHtml(paidDate)}</td>
                        <td>${fundingAccount}</td>
                        <td>${batchNo}</td>
                    </tr>`;
            });

            tbody.innerHTML = rows.join("");
        }

        function resetPaidFilters() {
            document.getElementById("paidType").value = "ALL TYPES";
            document.getElementById("paidFundingAccount").value = "ALL";
            document.getElementById("paidBatchNo").value = "";
            document.getElementById("paidStartDate").value = "";
            document.getElementById("paidEndDate").value = "";

            clearStatus("paidStatus");
            searchPaid();
        }

        // Excel export.
        function exportExcel(tableId, fileName) {
            const table = document.getElementById(tableId);

            if (!table) {
                alert("The selected table could not be found.");
                return;
            }

            const workbook = XLSX.utils.table_to_book(
                table,
                { sheet: "Sheet1" }
            );

            XLSX.writeFile(workbook, `${fileName}.xlsx`);
        }

        // PDF export.
        function exportPDF(elementId, fileName) {
            const element = document.getElementById(elementId);

            if (!element) {
                alert("The selected section could not be found.");
                return;
            }

            const options = {
                margin: 0.5,
                filename: `${fileName}.pdf`,
                image: {
                    type: "jpeg",
                    quality: 0.98
                },
                html2canvas: {
                    scale: 2
                },
                jsPDF: {
                    unit: "in",
                    format: "letter",
                    orientation: "landscape"
                }
            };

            html2pdf().set(options).from(element).save();
        }

        // Chart modal.
        function openChartModal(source) {
            currentChartData =
                source === "raised" ? raisedDataCache : paidDataCache;

            if (!currentChartData || currentChartData.length === 0) {
                alert(
                    "Please perform a search with records before viewing the chart."
                );
                return;
            }

            document.getElementById("chartModalTitle").textContent =
                (source === "raised" ? "Raised Vouchers" : "Paid Vouchers") +
                " - Classification Code Analysis";

            document.getElementById("chartModal").style.display = "block";

            document.getElementById("chartTypeSelect").value = "bar";
            renderChart("bar");
        }

        function closeChartModal() {
            document.getElementById("chartModal").style.display = "none";
        }

        function changeChartType() {
            renderChart(
                document.getElementById("chartTypeSelect").value
            );
        }

        function renderChart(chartType) {
            const codeCounts = {};

            currentChartData.forEach(item => {
                const code = getVal(
                    item,
                    ["classificationCode", "ClassificationCode"],
                    "Unclassified"
                ) || "Unclassified";

                codeCounts[code] = (codeCounts[code] || 0) + 1;
            });

            const labels = Object.keys(codeCounts);
            const counts = Object.values(codeCounts);

            const backgroundColors = [
                "#0b7a43", "#2b5b84", "#e67e22", "#9b59b6",
                "#f1c40f", "#e74c3c", "#1abc9c", "#34495e",
                "#d35400", "#7f8c8d"
            ];

            const canvas = document.getElementById("ledgerChart");
            const context = canvas.getContext("2d");

            if (activeChart) {
                activeChart.destroy();
            }

            activeChart = new Chart(context, {
                type: chartType,
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Classification Code Frequency",
                        data: counts,
                        backgroundColor:
                            chartType === "line"
                                ? "rgba(11, 122, 67, 0.2)"
                                : backgroundColors,
                        borderColor: "#0b7a43",
                        borderWidth: 1,
                        fill: chartType === "line"
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: chartType !== "bar"
                        }
                    },
                    scales:
                        chartType === "bar" || chartType === "line"
                            ? {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        stepSize: 1
                                    }
                                }
                            }
                            : {}
                }
            });
        }

                // Close either modal when the user clicks outside its content.
        window.addEventListener("click", function (event) {
            const chartModal = document.getElementById("chartModal");
            const analysisModal = document.getElementById("analysisModal");

            if (event.target === chartModal) {
                closeChartModal();
            }

            if (event.target === analysisModal) {
                closeAnalysedReport();
            }
        });
    </script>
</body>
</html>
