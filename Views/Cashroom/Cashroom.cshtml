@model List<FullVoucherSystem.Models.CashRoom>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cash Room - UBTH</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(to right, #e8f5e9, #c8e6c9);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 15px 25px;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,.1);
        }

        .logo-area {
            display: flex;
            align-items: center;
        }

            .logo-area img {
                width: 60px;
                height: auto;
            }

            .logo-area h2 {
                margin: 0 0 0 10px;
                color: #2e7d32;
            }

        .user-info {
            color: #2e7d32;
            font-weight: bold;
        }

        .container {
            padding: 30px;
            display: flex;
            justify-content: center;
        }

        .dashboard-box {
            background: #fff;
            padding: 30px;
            width: 100%;
            max-width: 1500px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,.1);
        }

        .page-title {
            text-align: center;
            color: #2e7d32;
            margin-bottom: 20px;
        }

        .message {
            color: #155724;
            text-align: center;
            font-weight: bold;
            margin-bottom: 15px;
            padding: 10px;
            background: #d4edda;
            border-radius: 5px;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 1250px;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th {
            background: #2e7d32;
            color: white;
            padding: 12px;
            text-align: left;
            white-space: nowrap;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            font-size: 14px;
            vertical-align: middle;
        }

        tbody tr:hover {
            background: #f1f8f4;
        }

        .checkbox-cell {
            text-align: center;
            width: 50px;
        }

        input[type="checkbox"] {
            transform: scale(1.2);
            cursor: pointer;
        }

        .row-input {
            width: 155px;
            min-width: 130px;
            padding: 8px;
            border: 1px solid #bdbdbd;
            border-radius: 4px;
            background: #fff;
            font-size: 13px;
        }

        .batch-input {
            width: 145px;
        }

        .btn-group {
            margin-top: 25px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 25px;
            border: none;
            color: #fff;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-size: 14px;
        }

        .btn-submit {
            background: #2e7d32;
        }

            .btn-submit:hover {
                background: #1b5e20;
            }

        .btn-close {
            background: #6c757d;
        }

            .btn-close:hover {
                background: #5a6268;
            }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 15px;
        }

        .modal-box {
            background: #fff;
            padding: 25px;
            border-radius: 8px;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 4px 15px rgba(0,0,0,.3);
        }

            .modal-box h3 {
                margin-top: 0;
                color: #2e7d32;
                text-align: center;
            }

        .form-group {
            margin-bottom: 15px;
        }

            .form-group label {
                display: block;
                font-weight: bold;
                margin-bottom: 5px;
                color: #333;
            }

            .form-group input {
                width: 100%;
                padding: 9px;
                border: 1px solid #ccc;
                border-radius: 4px;
            }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-modal-ok {
            background: #2e7d32;
        }

        .btn-modal-cancel {
            background: #dc3545;
        }

        @@media (max-width: 600px) {
            .header

        {
            align-items: flex-start;
            flex-direction: column;
        }

        .container {
            padding: 12px;
        }

        .dashboard-box {
            padding: 15px;
        }

        .logo-area h2 {
            font-size: 18px;
        }

        }
    </style>

    <script>
        function toggleSelectAll(master) {
            document.querySelectorAll(".voucher-checkbox")
                .forEach(function (checkbox) {
                    checkbox.checked = master.checked;
                });
        }

        function initiateSubmit() {
            const selected = document.querySelectorAll(
                ".voucher-checkbox:checked"
            );

            if (selected.length === 0) {
                alert("Please select at least one voucher to process.");
                return;
            }

            // Validate the account and batch number for each selected row.
            for (const checkbox of selected) {
                const row = checkbox.closest("tr");
                const account = row.querySelector(".funding-account");
                const batch = row.querySelector(".batch-number");

                if (!account || !account.value) {
                    alert("Please select a Funding Account for every selected voucher.");
                    account?.focus();
                    return;
                }

                if (!batch || !batch.value.trim()) {
                    alert("Please enter a Batch Number for every selected voucher.");
                    batch?.focus();
                    return;
                }
            }

            if (!confirm(
                "Are you sure you want to mark the selected vouchers as paid?"
            )) {
                return;
            }

            // Use the browser's local date to avoid UTC date shifts.
            const now = new Date();
            const localToday =
                now.getFullYear() + "-" +
                String(now.getMonth() + 1).padStart(2, "0") + "-" +
                String(now.getDate()).padStart(2, "0");

            document.getElementById("processedDateInput").value = localToday;
            document.getElementById("processingModal").style.display = "flex";
        }

        function closeModal() {
            document.getElementById("processingModal").style.display = "none";
        }

        function confirmAndSubmitForm() {
            const dateInput = document.getElementById("processedDateInput");

            if (!dateInput.value) {
                alert("Please select a Processed Date.");
                dateInput.focus();
                return;
            }

            document.getElementById("hiddenProcessedDate").value =
                dateInput.value;

            document.getElementById("cashroomForm").submit();
        }
    </script>
</head>

<body>
    <div class="header">
        <div class="logo-area">
            <img src="~/images/ubth-logo.jpeg" alt="UBTH Logo" />
            <h2>UBTH Cash Room</h2>
        </div>

        <div class="user-info">
            @ViewBag.Surname @ViewBag.FirstName
        </div>
    </div>

    <div class="container">
        <div class="dashboard-box">
            <h2 class="page-title">Cash Room Voucher Register</h2>

            @if (TempData["Message"] != null)
            {
                <div class="message">@TempData["Message"]</div>
            }

            <form id="cashroomForm"
                  action="@Url.Action("SubmitPaidVouchers", "Cashroom")"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="hiddenProcessedDate"
                       name="processedDate" />

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th class="checkbox-cell">
                                    <input type="checkbox"
                                           onclick="toggleSelectAll(this)"
                                           title="Select All" />
                                </th>
                                <th>ID</th>
                                <th>Voucher No</th>
                                <th>Payee</th>
                                <th>Amount</th>
                                <th>Total Amount</th>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Funding Account</th>
                                <th>Batch No.</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var voucher in Model)
                                {
                                    <tr>
                                        <td class="checkbox-cell">
                                            <input type="checkbox"
                                                   name="selectedVoucherIds"
                                                   value="@voucher.Id"
                                                   class="voucher-checkbox" />
                                        </td>

                                        <td>@voucher.Id</td>

                                        <td>
                                            <strong>@voucher.VoucherNumber</strong>
                                        </td>

                                        <td>@voucher.Payee</td>

                                        <td>@voucher.Amount.ToString("N2")</td>

                                        <td>
                                            @((voucher.TotalAmount ?? voucher.Amount).ToString("N2"))
                                        </td>

                                        <td>@voucher.Date.ToString("yyyy-MM-dd")</td>

                                        <td>@voucher.Description</td>

                                        <td>
                                            <select class="row-input funding-account"
                                                    name="fundingAccounts[@voucher.Id]"
                                                    aria-label="Funding Account for voucher @voucher.VoucherNumber">
                                                <option value="DRF" selected>DRF</option>
                                                <option value="DFR">DFR</option>
                                                <option value="MISCELLANEOUS">MISCELLANEOUS</option>
                                                <option value="NHIA">NHIA</option>
                                                <option value="SCHOOLS">SCHOOLS</option>
                                            </select>
                                        </td>

                                        <td>
                                            <input type="text"
                                                   class="row-input batch-input batch-number"
                                                   name="batchNumbers[@voucher.Id]"
                                                   maxlength="100"
                                                   placeholder="Enter Batch No."
                                                   aria-label="Batch Number for voucher @voucher.VoucherNumber" />
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10"
                                        style="text-align:center;color:#666;padding:20px;">
                                        No pending vouchers available in the Cash Room.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="btn-group">
                    <button type="button"
                            class="btn btn-submit"
                            onclick="initiateSubmit()">
                        Submit Paid Vouchers
                    </button>

                    <a href="@Url.Action("Index", "Dashboard")"
                       class="btn btn-close">
                        Back to Dashboard
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Processed Date confirmation modal -->
    <div id="processingModal" class="modal-overlay">
        <div class="modal-box">
            <h3>Confirm Payment Processing</h3>

            <div class="form-group">
                <label for="processedDateInput">Processed (Paid) Date:</label>
                <input type="date"
                       id="processedDateInput"
                       required />
            </div>

            <div class="modal-actions">
                <button type="button"
                        class="btn btn-modal-cancel"
                        onclick="closeModal()">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-modal-ok"
                        onclick="confirmAndSubmitForm()">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</body>
</html>
