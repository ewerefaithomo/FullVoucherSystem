            background: #f4f7f6;
            color: #333;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 30px;
            background-color: #ffffff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border-bottom: 3px solid #2e7d32;
        }

        .logo-area {
            display: flex;
            align-items: center;
        }

            .logo-area img {
                width: 55px;
                height: auto;
            }

            .logo-area h2 {
                margin: 0 0 0 15px;
                color: #2e7d32;
                font-size: 22px;
                font-weight: 700;
            }

        .user-info-area {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .btn-dashboard {
            background-color: #2e7d32;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .user-info {
            color: #2e7d32;
            font-weight: 600;
            font-size: 15px;
            background-color: #e8f5e9;
            padding: 8px 16px;
            border-radius: 20px;
        }

        .container {
            display: flex;
            justify-content: center;
            padding: 30px 15px;
        }

        .form-box {
            background: #ffffff;
            padding: 35px 40px;
            width: 100%;
            max-width: 800px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            border: 1px solid #e0e0e0;
        }

        .form-title {
            text-align: center;
            color: #2e7d32;
            margin-top: 0;
            margin-bottom: 30px;
            font-size: 24px;
            position: relative;
            padding-bottom: 10px;
        }

        .form-group-section {
            border: 1px solid #c8e6c9;
            border-radius: 8px;
            padding: 20px 22px 15px 22px;
            margin-bottom: 25px;
            background-color: #fafafa;
        }

            .form-group-section legend {
                padding: 0 12px;
                color: #1b5e20;
                font-size: 16px;
                font-weight: 700;
                text-transform: uppercase;
                background-color: #ffffff;
                border: 1px solid #a5d6a7;
                border-radius: 4px;
            }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px 20px;
        }

        .form-field {
            display: flex;
            flex-direction: column;
        }

            .form-field.full-width {
                grid-column: span 2;
            }

        .checkbox-field {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 5px;
        }

        label {
            font-weight: 600;
            font-size: 13px;
            color: #424242;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #bdc3c7;
            border-radius: 6px;
            font-size: 14px;
            background-color: #ffffff;
            color: #333;
        }

