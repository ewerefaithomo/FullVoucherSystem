                                    31060301 - SPECIAL IMPREST (SERVICE WIDE)
                                </option>

                                <option value="00000000 - UNPAID VOUCHERS">
                                    00000000 - UNPAID VOUCHERS
                                </option>

                                @if (!string.IsNullOrEmpty(Model.ClassificationCode))
                                {
                                    <option value="@Model.ClassificationCode"
                                            selected="selected">
                                        @Model.ClassificationCode
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="form-field">

                            <label>Source Classification Code</label>

                            <select asp-for="SourceClassificationCode">

                                <option value="">
                                    -- Select Source --
                                </option>

                                <option value="IGR">
                                    IGR
                                </option>

                                <option value="FEDERAL GOVERNMENT">
                                    FEDERAL GOVERNMENT
                                </option>

                                <option value="DONOR AGENCY">
                                    DONOR AGENCY
                                </option>

                                <option value="NHIA">
                                    NHIA
                                </option>

                                <option value="SPECIAL FUND">
                                    SPECIAL FUND
                                </option>

                                @if (!string.IsNullOrEmpty(Model.SourceClassificationCode))
                                {
                                    <option value="@Model.SourceClassificationCode"
                                            selected="selected">
                                        @Model.SourceClassificationCode
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="form-field">

                            <label>Date</label>

                            <input type="date"
                                   asp-for="Date"
                                   value="@(Model != null && Model.Date != DateTime.MinValue
                                                                          ? Model.Date.ToString("yyyy-MM-dd")
                                                                          : "")"
                                   required />

                        </div>

                    </div>

                </fieldset>


                <!-- =====================================================
                     2. PAYEE INFORMATION
                     ===================================================== -->

                <fieldset class="form-group-section">

                    <legend>
                        2. Payee Information & Preparation Details
                    </legend>

                    <div class="form-grid">

                        <div class="form-field full-width">

                            <label>Payee</label>

                            <input asp-for="Payee"
                                   placeholder="Payee Name"
                                   required />

                        </div>

                        <div class="form-field full-width">

                            <label>Address</label>

                            <input asp-for="Address"
                                   placeholder="Address"
                                   required />

                        </div>

                        <div class="form-field full-width">

                            <label>Description</label>

                            <textarea asp-for="Description"
                                      rows="4"
                                      required></textarea>

                        </div>

                        <div class="form-field">

                            <label>First Name (Preparer)</label>

                            <input asp-for="Voucher_FirstName"
                                   type="text" />

                        </div>

                        <div class="form-field">

                            <label>Surname (Preparer)</label>

                            <input asp-for="Voucher_Surname"
                                   type="text" />

                        </div>

                        <div class="form-field full-width">

                            <label>Designation</label>

                            <input asp-for="Voucher_Designation"
                                   type="text" />

                        </div>

                    </div>

                </fieldset>


                <!-- =====================================================
                     3. FINANCIAL DETAILS
                     ===================================================== -->

                <fieldset class="form-group-section">

                    <legend>
                        3. Financial & Deduction Details
                    </legend>

                    <div class="form-grid">

                        <!-- VOUCHER AMOUNT -->

                        <div class="form-field full-width">

                            <label>
                                Voucher (Gross) Amount 
                            </label>

                            <input type="number"
                                   step="0.01"
                                   asp-for="Amount"
                                   id="Amount"
                                   placeholder="0.00"
                                   required
                                   class="amount-input"
                                   autocomplete="off" />

                        </div>


                        <!-- VAT -->

                        <div class="form-field">

                            <label>FGN VAT (%)</label>

                            <input type="text"
                                   id="vatOption"
                                   name="vatOption"
                                   value="@ViewBag.VatOption" />

                        </div>


                        <!-- FGN WHT -->

                        <div class="form-field">

                            <label>FGN WHT (%)</label>

                            <input type="text"
                                   id="fgn_whtOption"
                                   name="fgn_whtOption"
                                   value="@ViewBag.FgnWhtOption" />

                        </div>


                        <!-- EDG WHT -->

                        <div class="form-field">

                            <label>EDG WHT (%)</label>

                            <input type="text"
                                   id="edg_whtOption"
                                   name="edg_whtOption"
                                   value="@ViewBag.EdgWhtOption" />

                        </div>


                        <!-- STAMP -->

                        <div class="form-field">

                            <label>Stamp Duty (%)</label>

                            <input type="text"
                                   id="stampOption"
                                   name="stampOption"
                                   value="@ViewBag.StampOption" />

                        </div>


                        <!-- VAT BASIS -->

                        <div class="form-field full-width">

                            <label style="margin-bottom: 8px;">
                                VAT Calculation Basis
                                <span style="color: red;">*</span>
                            </label>

                            <div style="display: flex; gap: 20px; align-items: center;">

                                <div class="checkbox-field">

                                    <input type="radio"
                                           id="vatInclusive"
                                           name="isVatInclusive"
                                           value="true"
                                           required
                                           checked />

                                    <label for="vatInclusive">
                                        FGN VAT Inclusive
                                    </label>

                                </div>

                                <div class="checkbox-field">

                                    <input type="radio"
                                           id="vatExclusive"
                                           name="isVatInclusive"
                                           value="false"
                                           required />

                                    <label for="vatExclusive">
                                        FGN VAT Exclusive
                                    </label>

                                </div>

                            </div>

                        </div>

                    </div>

                </fieldset>


                <!-- ACTIONS -->

                <div class="actions-area">

                    <button type="submit">
                        Save Changes
                    </button>

                    <a asp-action="AuditQueriedVouchers"
                       class="close-btn">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>

        $(document).ready(function () {

            /* =====================================================
               CLASSIFICATION SELECT2
               ===================================================== */

            $('#ClassificationCode').select2({
                placeholder: "-- Select or Type Classification Code --",
                allowClear: true,
                tags: true
            });


            /* =====================================================
               PREVENT MOUSE WHEEL FROM CHANGING VOUCHER AMOUNT

               IMPORTANT:
               - Mouse wheel cannot change the amount.
               - Keyboard typing remains enabled.
               - Keyboard Arrow Up/Down remains enabled.
               - The field remains editable.
               ===================================================== */

            const amountInput = document.getElementById('Amount');

            if (amountInput) {

                amountInput.addEventListener('wheel', function (event) {

                    // Completely stop the browser from processing
                    // the wheel event on the number input.
                    event.preventDefault();
                    event.stopPropagation();

                }, {
                    passive: false
                });

                /*
                 * Additional protection for browsers that process
                 * wheel events at the document level.
                 */
                amountInput.addEventListener('mousewheel', function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                }, {
                    passive: false
                });

                amountInput.addEventListener('DOMMouseScroll', function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                }, {
                    passive: false
                });

            }


            /* =====================================================
               VAT VALIDATION
               ===================================================== */

            $('#voucherForm').on('submit', function (e) {

                if (!$('input[name="isVatInclusive"]:checked').length) {

                    e.preventDefault();

                    alert(
                        'Please select either FGN VAT Inclusive or FGN VAT Exclusive before saving changes.'
                    );

                    return false;
                }

            });

        });

    </script>

</body>
</html>