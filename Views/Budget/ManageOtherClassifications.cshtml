@model FullVoucherSystem.Models.OtherClassificationBudgetViewModel
@using Microsoft.AspNetCore.Http

@{
    Layout = null;
    ViewData["Title"] = "Other Classification Codes Budget";

    var surname = Context.Session.GetString("Surname");
    var firstName = Context.Session.GetString("FirstName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Other Classification Codes - UBTH Budget Management</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f8f4;
            color: #1e3d2f;
        }

        .header {
            background: #fff;
            border-bottom: 5px solid #0b7a43;
            padding: 18px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 15px;
        }

            .brand img {
                width: 70px;
                height: 70px;
                object-fit: contain;
            }

            .brand h1 {
                margin: 0;
                font-size: 22px;
                color: #0b7a43;
            }

            .brand p {
                margin: 5px 0 0;
                font-size: 14px;
                color: #4b6354;
            }

        .header-links {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

            .header-links a {
                text-decoration: none;
                font-size: 14px;
                font-weight: bold;
            }

        .back-link {
            color: #0b7a43;
        }

        .logout-link {
            background: #b82c2c;
            color: white;
            padding: 9px 14px;
            border-radius: 5px;
        }

        .container {
            width: 96%;
            max-width: 1400px;
            margin: 25px auto;
        }

        .page-heading {
            background: white;
            border-left: 6px solid #0b7a43;
            border-radius: 8px;
            padding: 22px;
            margin-bottom: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,.06);
        }

            .page-heading h2 {
                color: #0b7a43;
                margin: 0 0 8px;
            }

            .page-heading p {
                color: #555;
                margin: 0;
                line-height: 1.5;
            }

        .message {
            padding: 13px 16px;
            border-radius: 5px;
            margin-bottom: 18px;
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .validation {
            background: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
            border-radius: 5px;
            padding: 12px 16px;
            margin-bottom: 18px;
        }

        .table-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0,0,0,.07);
            overflow: hidden;
        }

        .table-scroll {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 650px;
        }

        thead th {
            background: #0b7a43;
            color: white;
            text-align: left;
            padding: 15px 14px;
            font-size: 15px;
        }

        tbody td {
            padding: 10px 14px;
            border-bottom: 1px solid #e2e9e3;
            vertical-align: middle;
            font-size: 14px;
        }

        tbody tr:nth-child(even) {
            background: #f7faf7;
        }

        tbody tr:hover {
            background: #edf6ef;
        }

        .classification-column {
            width: 65%;
        }

        .classification-code {
            display: block;
            font-weight: bold;
            color: #28543a;
            margin-bottom: 4px;
        }

        .classification-description {
            display: block;
            color: #374b3e;
            line-height: 1.45;
        }

        .amount-column {
            width: 35%;
        }

        .amount-input {
            width: 100%;
            min-width: 150px;
            padding: 10px;
            border: 1px solid #b9c9bd;
            border-radius: 5px;
            font-size: 14px;
        }

            .amount-input:focus {
                outline: 2px solid #9acba9;
                border-color: #0b7a43;
            }

        .table-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            padding: 20px;
        }

        .note {
            color: #666;
            font-size: 13px;
            line-height: 1.5;
            max-width: 700px;
        }

        .submit-button {
            background: #0b7a43;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 13px 26px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
        }

            .submit-button:hover {
                background: #075b32;
            }

        .footer {
            margin-top: 35px;
            background: #0b7a43;
            color: white;
            text-align: center;
            padding: 15px;
            font-size: 14px;
        }

        @@media (max-width: 768px) {
            .header {
                padding: 15px;
            }

            .brand img {
                width: 55px;
                height: 55px;
            }

            .brand h1 {
                font-size: 18px;
            }

            .container {
                width: 94%;
            }

            .table-footer {
                align-items: stretch;
                flex-direction: column;
            }

            .submit-button {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <header class="header">
        <div class="brand">
            <img src="@Url.Content("~/images/ubth-logo.jpeg")"
                 alt="UBTH Logo" />

            <div>
                <h1>University of Benin Teaching Hospital</h1>
                <p>Voucher Management Portal — Budget Management</p>
            </div>
        </div>

        <div class="header-links">
            <span>Welcome, <strong>@surname @firstName</strong></span>
            <a class="back-link" href="/Dashboard/Index">Dashboard</a>
            <a class="logout-link" href="/Account/Logout">Log Out</a>
        </div>
    </header>

    <main class="container">

        @if (TempData["Message"] != null)
        {
            <div class="message" role="status">
                @TempData["Message"]
            </div>
        }

        <section class="page-heading">
            <h2>Other Classification Codes</h2>
            <p>
                Enter the approved budget amount for each applicable
                classification. Amounts are entered in Nigerian naira (₦).
                Leave a field blank to leave its existing budget unchanged.
            </p>
        </section>

        <div asp-validation-summary="All" class="validation"></div>

        <form asp-controller="Budget"
              asp-action="ManageOtherClassifications"
              method="post">

            @Html.AntiForgeryToken()

            <div class="table-card">
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col" class="classification-column">
                                    Other Classification Code
                                </th>
                                <th scope="col" class="amount-column">
                                    Budget Amount
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <span class="classification-code">
                                            @Model.Items[i].ClassificationCode
                                        </span>

                                        <span class="classification-description">
                                            @Model.Items[i].Description
                                        </span>

                                        <input type="hidden"
                                               name="Items[@i].ClassificationCode"
                                               value="@Model.Items[i].ClassificationCode" />

                                        <input type="hidden"
                                               name="Items[@i].Description"
                                               value="@Model.Items[i].Description" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="amount-input"
                                               name="Items[@i].BudgetAmount"
                                               value="@Model.Items[i].BudgetAmount"
                                               min="0"
                                               max="999999999999999.99"
                                               step="0.01"
                                               inputmode="decimal"
                                               placeholder="Enter budget amount"
                                               aria-label="Budget amount for @Model.Items[i].Description" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    <div class="note">
                        Enter figures only; currency symbols and commas
                        are not required. Blank fields do not erase
                        previously saved budget amounts.
                    </div>

                    <button type="submit" class="submit-button">
                        Submit Budget
                    </button>
                </div>
            </div>
        </form>
    </main>

    <footer class="footer">
        UNIVERSITY OF BENIN TEACHING HOSPITAL
        &copy; @DateTime.Now.Year Voucher Management System
    </footer>
</body>
</html>
