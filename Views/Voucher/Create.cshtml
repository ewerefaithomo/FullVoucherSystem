<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Voucher Entry - UBTH</title>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f7f6;
            color: #333;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 30px;
            background-color: #ffffff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border-bottom: 3px solid #2e7d32;
        }

        .logo-area {
            display: flex;
            align-items: center;
        }

            .logo-area img {
                width: 55px;
                height: auto;
            }

            .logo-area h2 {
                margin: 0 0 0 15px;
                color: #2e7d32;
                font-size: 22px;
                font-weight: 700;
            }

        .user-info {
            color: #2e7d32;
            font-weight: 600;
            font-size: 15px;
            background-color: #e8f5e9;
            padding: 8px 16px;
            border-radius: 20px;
        }

        .container {
            display: flex;
            justify-content: center;
            padding: 30px 15px;
        }

        .form-box {
            background: #ffffff;
            padding: 35px 40px;
            width: 100%;
            max-width: 800px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            border: 1px solid #e0e0e0;
        }

        .form-title {
            text-align: center;
            color: #2e7d32;
            margin-top: 0;
            margin-bottom: 30px;
            font-size: 24px;
            position: relative;
            padding-bottom: 10px;
        }

            .form-title::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 60px;
                height: 3px;
                background-color: #2e7d32;
                border-radius: 2px;
            }

        .form-group-section {
            border: 1px solid #c8e6c9;
            border-radius: 8px;
            padding: 20px 22px 15px 22px;
            margin-bottom: 25px;
            background-color: #fafafa;
        }

            .form-group-section legend {
                padding: 0 12px;
                color: #1b5e20;
                font-size: 16px;
                font-weight: 700;
                text-transform: uppercase;
                background-color: #ffffff;
                border: 1px solid #a5d6a7;
                border-radius: 4px;
            }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px 20px;
        }

        .form-field {
            display: flex;
            flex-direction: column;
        }

            .form-field.full-width {
                grid-column: span 2;
            }

        .checkbox-field {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 5px;
        }

            .checkbox-field input[type="checkbox"], .checkbox-field input[type="radio"] {
                width: 18px;
                height: 18px;
                cursor: pointer;
                accent-color: #2e7d32;
            }

        label {
            font-weight: 600;
            font-size: 13px;
            color: #424242;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        input, select, textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #bdc3c7;
            border-radius: 6px;
            font-size: 14px;
            background-color: #ffffff;
            color: #333;
        }

            input:focus, select:focus, textarea:focus {
                outline: none;
                border-color: #2e7d32;
                box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.15);
            }

            /* Hides Up/Down arrows (spinners) on numeric input fields */
            input[type="number"]::-webkit-outer-spin-button,
            input[type="number"]::-webkit-inner-spin-button {
                -webkit-appearance: none;
                margin: 0;
            }

            input[type="number"] {
                -moz-appearance: textfield;
            }

        .readonly-box {
            background-color: #f1f8e9 !important;
            font-weight: 700;
            color: #2e7d32;
            border-color: #a5d6a7;
        }

        .select2-container {
            width: 100% !important;
        }

        .select2-container--default .select2-selection--single {
            min-height: 40px !important;
            border: 1px solid #bdc3c7 !important;
            border-radius: 6px !important;
            display: flex !important;
            align-items: center;
        }

        .actions-area {
            display: flex;
            gap: 15px;
            margin-top: 25px;
        }

        button[type="submit"] {
            flex: 2;
            padding: 12px 20px;
            background-color: #2e7d32;
            border: none;
            color: white;
            font-size: 15px;
            font-weight: 700;
            border-radius: 6px;
            cursor: pointer;
        }

            button[type="submit"]:hover {
                background-color: #1b5e20;
            }

        .close-btn {
            flex: 1;
            padding: 12px 20px;
            background-color: #616161;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 600;
            text-align: center;
        }

        .success-message {
            color: #2e7d32;
            text-align: center;
            margin-top: 20px;
            padding: 10px;
            background-color: #e8f5e9;
            border: 1px solid #a5d6a7;
            border-radius: 6px;
            font-weight: 600;
        }

        /* Blinking animation for critical red error messages */
        @@keyframes blinkAlert {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.15;
            }

            100% {
                opacity: 1;
            }
        }

        .blinking-error-banner {
            color: #d32f2f;
            background-color: #ffebee;
            border: 2px solid #d32f2f;
            padding: 14px 20px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 16px;
            text-align: center;
            margin-bottom: 20px;
            animation: blinkAlert 1s infinite;
        }
    </style>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="blinking-error-banner">
            ⚠️ @ViewBag.ErrorMessage
        </div>
    }
</head>
<body>
    <div class="header">
        <div class="logo-area">
            <img src="~/images/ubth-logo.jpeg" alt="UBTH Logo" />
            <h2>UBTH Voucher System</h2>
        </div>
        <div class="user-info">@ViewBag.Surname @ViewBag.FirstName</div>
    </div>

    <div class="container">
        <div class="form-box">
            <h2 class="form-title">Voucher Entry Form</h2>

            <form asp-controller="Voucher" asp-action="@(Model != null && Model.Id > 0 ? "Edit" : "Create")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model?.Id" />

                <fieldset class="form-group-section">
                    <legend>1. Voucher & Classification Details</legend>
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="voucherType">Voucher Type</label>
                            <select name="VoucherType" id="voucherType" onchange="generateVoucherNumber()" required>
                                <option value="">-- Select Voucher Type --</option>
                                <option value="S" @(Model?.VoucherType == "S" ? "selected" : "")>S - STAFF</option>
                                <option value="SA" @(Model?.VoucherType == "SA" ? "selected" : "")>SA - STAFF ADVANCES</option>
                                <option value="SA-2" @(Model?.VoucherType == "SA-2" ? "selected" : "")>SA-2 - STAFF ADVANCES-IMPREST</option>
                                <option value="E" @(Model?.VoucherType == "E" ? "selected" : "")>E - EXTERNAL</option>
                                <option value="EE" @(Model?.VoucherType == "EE" ? "selected" : "")>EE - EXTERNAL ENGINEERING</option>
                                <option value="ES" @(Model?.VoucherType == "ES" ? "selected" : "")>ES - EXTERNAL SUPPLY</option>
                                <option value="EL" @(Model?.VoucherType == "EL" ? "selected" : "")>EL - EXTERNAL LABOURATORY</option>
                                <option value="EP" @(Model?.VoucherType == "EP" ? "selected" : "")>EP - EXTERNAL PHARMACY</option>
                                <option value="ER" @(Model?.VoucherType == "ER" ? "selected" : "")>ER - EXTERNAL RADIOLOGY</option>
                                <option value="ICH" @(Model?.VoucherType == "ICH" ? "selected" : "")>ICH - INSTITUTE OF CHILD HEALTH</option>
                                <option value="C" @(Model?.VoucherType == "C" ? "selected" : "")>C - CAPITAL</option>
                                <option value="C2" @(Model?.VoucherType == "C2" ? "selected" : "")>C2 - IGR CAPITAL</option>
                            </select>
                        </div>

                        <div class="form-field">
                            <label for="voucherNumber">Voucher Number</label>
                            <input type="text" name="VoucherNumber" id="voucherNumber" class="readonly-box" value="@Model?.VoucherNumber" readonly />
                        </div>

                        <div class="form-field">
                            <label>Checked Location</label>
                            <input name="CheckedLocation" value="@(string.IsNullOrWhiteSpace(Model?.CheckedLocation) ? "BENIN CITY" : Model.CheckedLocation)" />
                        </div>

                        <div class="form-field">
                            <label>Station</label>
                            <input name="Station" value="@(string.IsNullOrWhiteSpace(Model?.Station) ? "BENIN CITY" : Model.Station)" />
                        </div>

                        <div class="form-field">
                            <label for="accountCode">Account Code</label>
                            <select name="AccountCode" id="accountCode">
                                <option value="">-- Select Account Code --</option>
                                <option value="001" @(Model?.AccountCode == "001" ? "selected" : "")>001</option>
                                <option value="002" @(Model?.AccountCode == "002" ? "selected" : "")>002</option>
                                <option value="003" @(Model?.AccountCode == "003" ? "selected" : "")>003</option>
                                <option value="004" @(Model?.AccountCode == "004" ? "selected" : "")>004</option>
                                <option value="005" @(Model?.AccountCode == "005" ? "selected" : "")>005</option>
                                <option value="006" @(Model?.AccountCode == "006" ? "selected" : "")>006</option>
                            </select>
                        </div>

                        <div class="form-field">
                            <label>Head</label>
                            <input name="Head" value="@(string.IsNullOrWhiteSpace(Model?.Head) ? "0521" : Model.Head)" />
                        </div>

                        <div class="form-field">
                            <label>Sub Head</label>
                            <input name="SubHead" value="@(string.IsNullOrWhiteSpace(Model?.SubHead) ? "026006" : Model.SubHead)" />
                        </div>

                        <div class="form-field full-width">
                            <label for="ClassificationCode">Classification Code</label>
                            <select id="ClassificationCode" name="ClassificationCode">
                                <option value="">-- Select or Type Classification Code --</option>
                                @if (isCustomValue)
                                {
                                    <option value="@Model.ClassificationCode" selected="selected">@Model.ClassificationCode</option>
                                }
                                <option value="230101" @(Model?.ClassificationCode == "230101" ? "selected" : "")>230101 - PURCHASE OF FIXED ASSETS - GENERAL</option>
                                <option value="23010105" @(Model?.ClassificationCode == "23010105" ? "selected" : "")>23010105 - PURCHASE OF MOTOR VEHICLES</option>
                                <option value="23010106" @(Model?.ClassificationCode == "23010106" ? "selected" : "")>23010106 - PURCHASE OF VANS</option>
                                <option value="23010107" @(Model?.ClassificationCode == "23010107" ? "selected" : "")>23010107 - PURCHASE OF TRUCKS</option>
                                <option value="23010112.1" @(Model?.ClassificationCode == "23010112.1" ? "selected" : "")>23010112.1 - OFFICE EQUIPMENTS (A/C, FRIDGES, FANS ETC)</option>
                                <option value="23010112.2" @(Model?.ClassificationCode == "23010112.2" ? "selected" : "")>23010112.2 - OFFICE FURNITURES AND FITTINGS (WARDS)</option>
                                <option value="23010112.4" @(Model?.ClassificationCode == "23010112.4" ? "selected" : "")>23010112.4 - OFFICE FURNITURES AND FITTINGS (GUEST HOUSE)</option>
                                <option value="23010112.5" @(Model?.ClassificationCode == "23010112.5" ? "selected" : "")>23010112.5 - OFFICE FURNITURES AND FITTINGS (OFFICES)</option>
                                <option value="23010112.6" @(Model?.ClassificationCode == "23010112.6" ? "selected" : "")>23010112.6 - OFFICE FURNITURES AND FITTINGS OTHERS</option>
                                <option value="23010113" @(Model?.ClassificationCode == "23010113" ? "selected" : "")>23010113 - PURCHASE OF COMPUTERS</option>
                                <option value="23010114" @(Model?.ClassificationCode == "23010114" ? "selected" : "")>23010114 - PURCHASE OF COMPUTER PRINTERS</option>
                                <option value="23010115" @(Model?.ClassificationCode == "23010115" ? "selected" : "")>23010115 - PURCHASE OF PHOTOCOPYING MACHINES</option>
                                <option value="23010118" @(Model?.ClassificationCode == "23010118" ? "selected" : "")>23010118 - PURCHASE OF SCANNERS</option>
                                <option value="23010119" @(Model?.ClassificationCode == "23010119" ? "selected" : "")>23010119 - PURCHASE OF POWER GENERATING SET</option>
                                <option value="23010120" @(Model?.ClassificationCode == "23010120" ? "selected" : "")>23010120 - PURCHASE OF KITCHEN EQUIPMENT</option>
                                <option value="23010122.2" @(Model?.ClassificationCode == "23010122.2" ? "selected" : "")>23010122.2 - ENGINEERING EQUIPMENTS</option>
                                <option value="23010122.3" @(Model?.ClassificationCode == "23010122.3" ? "selected" : "")>23010122.3 - PURCHASE OF LABORATORY EQUIPMENTS</option>
                                <option value="23010122.4" @(Model?.ClassificationCode == "23010122.4" ? "selected" : "")>23010122.4 - HOLTICULTURE UNIT</option>
                                <option value="23010122.5" @(Model?.ClassificationCode == "23010122.5" ? "selected" : "")>23010122.5 - XRAY EQUIPMENTS</option>
                                <option value="23010122.15" @(Model?.ClassificationCode == "23010122.15" ? "selected" : "")>23010122.15 - PURCHASE OF DENTAL EQUIPMENTS</option>
                                <option value="23010123" @(Model?.ClassificationCode == "23010123" ? "selected" : "")>23010123 - MEDICAL AND SURGICAL EQUIPMENT</option>
                                <option value="23010122.7" @(Model?.ClassificationCode == "23010122.7" ? "selected" : "")>23010122.7 - PURCHASE OF MEDICAL & SURGICAL EQUIPMENTS</option>
                                <option value="23010122.1" @(Model?.ClassificationCode == "23010122.1" ? "selected" : "")>23010122.1 - PURCHASE OF ENGINEERING EQUIPMENT</option>
                                <option value="23010122.9" @(Model?.ClassificationCode == "23010122.9" ? "selected" : "")>23010122.9 - BOREHOLE AND SUBMERSIBLE PUMP</option>
                                <option value="23010122.16" @(Model?.ClassificationCode == "23010122.16" ? "selected" : "")>23010122.16 - PURCHASE OF OPTHAMOLOGY EQUIPMENTS</option>
                                <option value="23010122.17" @(Model?.ClassificationCode == "23010122.17" ? "selected" : "")>23010122.17 - PURCHASE OF OTHER MEDICAL EQUIPMENT</option>
                                <option value="23010122.18" @(Model?.ClassificationCode == "23010122.18" ? "selected" : "")>23010122.18 - OTHER MEDICAL EQUIPMENTS</option>
                                <option value="23010124" @(Model?.ClassificationCode == "23010124" ? "selected" : "")>23010124 - PURCHASE OF LIBRARY BOOKS AND EQUIPMENT</option>
                                <option value="23010126" @(Model?.ClassificationCode == "23010126" ? "selected" : "")>23010126 - PURCHASE OF SPORTING/GAMING EQUIPMENT</option>
                                <option value="23020103" @(Model?.ClassificationCode == "23020103" ? "selected" : "")>23020103 - CONSTRUCTION/ PROVISION OF ELECTRICITY</option>
                                <option value="23030102" @(Model?.ClassificationCode == "23030102" ? "selected" : "")>23030102 - REHABILITATION/REPAIRS-ELECTRICITY</option>
                                <option value="23010128" @(Model?.ClassificationCode == "23010128" ? "selected" : "")>23010128 - PURCHASE OF INDUSTRIAL EQUIPMENT</option>
                                <option value="230201" @(Model?.ClassificationCode == "230201" ? "selected" : "")>230201 - CONSTRUCTION/PROVISION OF FIXED ASSETS - GENERAL</option>
                                <option value="23020102" @(Model?.ClassificationCode == "23020102" ? "selected" : "")>23020102 - CONSTRUCTION/PROVISION OF RESIDENTIAL BUILDINGS</option>
                                <option value="23020101" @(Model?.ClassificationCode == "23020101" ? "selected" : "")>23020101 - CONSTRUCTION/PROVISION OF OFFICE BUILDINGS</option>
                                <option value="23020105" @(Model?.ClassificationCode == "23020105" ? "selected" : "")>23020105 - CONSTRUCTION/PROVISION OF WATER</option>
                                <option value="23020106" @(Model?.ClassificationCode == "23020106" ? "selected" : "")>23020106 - CONSTRUCTION/PROVISION OF HOSPITALS / HEALTH CENTRES</option>
                                <option value="23030105" @(Model?.ClassificationCode == "23030105" ? "selected" : "")>23030105 - REHABILITATION/REPAIRS-HOSPITAL/HEALTH CENTRES</option>
                                <option value="23020114" @(Model?.ClassificationCode == "23020114" ? "selected" : "")>23020114 - CONSTRUCTION/PROVISION OF ROAD</option>
                                <option value="23020118" @(Model?.ClassificationCode == "23020118" ? "selected" : "")>23020118 - CONSTRUCTION/PROVISION OF INFRASTRUCTURE- HOUSING</option>
                                <option value="23020122" @(Model?.ClassificationCode == "23020122" ? "selected" : "")>23020122 - CONSTRUCTION OF SHOPPING COMPLEX</option>
                                <option value="23030101" @(Model?.ClassificationCode == "23030101" ? "selected" : "")>23030101 - REHABILITATION/REPAIRS OF RESIDENTIAL BUILDING</option>
                                <option value="23050102" @(Model?.ClassificationCode == "23050102" ? "selected" : "")>23050102 - COMPUTER SOFTWARE ACQUISITION</option>
                                <option value="23050101" @(Model?.ClassificationCode == "23050101" ? "selected" : "")>23050101 - RESEARCH AND DEVELOPMENT</option>
                                <option value="23050104" @(Model?.ClassificationCode == "23050104" ? "selected" : "")>23050104 - ANNIVERSARIES/CELEBRATIONS</option>
                                <option value="21010102" @(Model?.ClassificationCode == "21010102" ? "selected" : "")>21010102 - OVERTIME PAYMENTS</option>
                                <option value="21020101" @(Model?.ClassificationCode == "21020101" ? "selected" : "")>21020101 - NON REGULAR ALLOWANCES (UNIFORM ALLOWANCES, NYSC ALLOWANCE)</option>
                                <option value="22010103" @(Model?.ClassificationCode == "22010103" ? "selected" : "")>22010103 - DEATH BENEFITS</option>
                                <option value="22020101" @(Model?.ClassificationCode == "22020101" ? "selected" : "")>22020101 - LOCAL TRAVEL & TRANSPORT: TRAINING</option>
                                <option value="22020102" @(Model?.ClassificationCode == "22020102" ? "selected" : "")>22020102 - LOCAL TRAVEL & TRANSPORT: OTHERS</option>
                                <option value="22020103" @(Model?.ClassificationCode == "22020103" ? "selected" : "")>22020103 - INTERNATIONAL TRAVEL & TRANSPORT: TRAINING</option>
                                <option value="22020201" @(Model?.ClassificationCode == "22020201" ? "selected" : "")>22020201 - ELECTRICITY CHARGES</option>
                                <option value="22020202" @(Model?.ClassificationCode == "22020202" ? "selected" : "")>22020202 - TELEPHONE CHARGES</option>
                                <option value="22020203" @(Model?.ClassificationCode == "22020203" ? "selected" : "")>22020203 - INTERNET ACCESS CHARGES</option>
                                <option value="22020301" @(Model?.ClassificationCode == "22020301" ? "selected" : "")>22020301 - OFFICE STATIONERIES / COMPUTER CONSUMABLES</option>
                                <option value="22020303" @(Model?.ClassificationCode == "22020303" ? "selected" : "")>22020303 - NEWSPAPERS</option>
                                <option value="22020304" @(Model?.ClassificationCode == "22020304" ? "selected" : "")>22020304 - MAGAZINES & PERIODICALS</option>
                                <option value="22020305" @(Model?.ClassificationCode == "22020305" ? "selected" : "")>22020305 - PRINTING OF NON SECURITY DOCUMENTS</option>
                                <option value="22020307.1" @(Model?.ClassificationCode == "22020307.1" ? "selected" : "")>22020307.1 - DRUGS</option>
                                <option value="22020307.2" @(Model?.ClassificationCode == "22020307.2" ? "selected" : "")>22020307.2 - BLOOD TRANSFUSION/ HEAMATOLOGY</option>
                                <option value="22020307.3" @(Model?.ClassificationCode == "22020307.3" ? "selected" : "")>22020307.3 - CHEMICAL PATHOLOGY</option>
                                <option value="22020307.4" @(Model?.ClassificationCode == "22020307.4" ? "selected" : "")>22020307.4 - ELECTROCARDIOGRAM (E.C.G.)</option>
                                <option value="22020307.6" @(Model?.ClassificationCode == "22020307.6" ? "selected" : "")>22020307.6 - MICROBIOLOGY</option>
                                <option value="22020307.7" @(Model?.ClassificationCode == "22020307.7" ? "selected" : "")>22020307.7 - MORBID ANATOMY & MORTUARY</option>
                                <option value="22020307.9" @(Model?.ClassificationCode == "22020307.9" ? "selected" : "")>22020307.9 - O&G CONSUMABLES</option>
                                <option value="22020307.11" @(Model?.ClassificationCode == "22020307.11" ? "selected" : "")>22020307.11 - OPTHAMOLOGY MATERIALS</option>
