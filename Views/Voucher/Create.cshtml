@model FullVoucherSystem.Models.Voucher

@{
    Layout = null;

    var predefinedCodes = new List<string> {
        "21010102", "21020101", "22010103", "22020101", "22020102", "22020103",
        "22020201", "22020202", "22020203", "22020301", "22020303", "22020304",
        "22020305", "22020307.1", "22020307.2", "22020307.3", "22020307.4", "22020307.6",
        "22020307.7", "22020307.9", "22020307.10", "22020307.11", "22020307.12",
        "22020307.13", "22020307.14", "22020307.15", "22020307.16", "22020307.19",
        "22020307.21", "22020307.22", "22020307.23", "22020307.24", "22020307.25",
        "22020307.28", "22020307.29", "22020307.31", "22020307.32", "22020309",
        "22020311", "22020401", "22020402", "22020403", "22020404", "22020405",
        "22020406", "22020406.2", "22020406.3", "22020406.4", "22020406.5",
        "22020406.6", "22020406.7", "22020406.8", "22020406.9", "22020406.10",
