    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#ClassificationCode').select2({
                placeholder: "-- Select or Type Classification Code --",
                allowClear: true,
                tags: true
            });

            // Prevent scroll wheel from changing number input values
            $(document).on('wheel', 'input[type=number]', function (e) {
                $(this).blur();
            });
        });

        function generateVoucherNumber() {
            var voucherType = document.getElementById("voucherType").value;
            if (voucherType === "") return;

            fetch('/Voucher/GenerateVoucherNumber?voucherType=' + voucherType)
                .then(response => response.json())
                .then(data => { document.getElementById("voucherNumber").value = data; })
                .catch(error => console.error("Error:", error));
        }
    </script>
