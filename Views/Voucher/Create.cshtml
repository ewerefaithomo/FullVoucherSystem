                        </div>

                        <div class="form-field">
                            <label>Stamp Duty (%)</label>
                            <input type="text" id="stampOption" name="stampOption" value="@(string.IsNullOrEmpty(Model?.StampOption) ? "0%" : Model.StampOption)" />
                        </div>

